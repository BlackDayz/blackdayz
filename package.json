    "@nuxt/image": "^2.1.0",
    "@nuxt/kit": "^4.5.1",
    "@nuxt/typescript-build": "^3.0.2",
    "@nuxt/typescript-runtime": "^3.0.2",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^5.3.6",
    "@pinia/nuxt": "^1.0.1",
    "@sentry/nuxt": "^10.69.0",
    "@types/js-yaml": "^4.0.9",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "ipx": "4.0.0-beta.1",
